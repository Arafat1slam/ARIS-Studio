# ==============================================================================
# ARIS Content Automation System - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to Git or public repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Brand Settings
# ------------------------------------------------------------------------------
BRAND_NAME=ARIS ANIME
WEBSITE_URL=https://aris-anime.com
PORT=5678
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
# Execution mode: 'review' (approval required before posting) or 'auto' (fully automatic)
PIPELINE_MODE=review

# ------------------------------------------------------------------------------
# 2. Gemini API (Free Tier Quota)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. YouTube Data API v3 (Google Cloud Console OAuth 2.0 Client)
# ------------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# ------------------------------------------------------------------------------
# 4. Meta Graph API (Facebook Page Access Token)
# ------------------------------------------------------------------------------
# Scopes needed: pages_manage_posts, pages_read_engagement, publish_video
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 5. Google Search Console API (Read-Only SEO Metrics)
# ------------------------------------------------------------------------------
GSC_SITE_URL=sc-domain:aris-anime.com
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 6. Local Path Overrides (Optional - defaults to relative project paths)
# ------------------------------------------------------------------------------
FFMPEG_PATH=tools/ffmpeg.exe
APPROVED_CLIPS_DIR=data/approved_clips
PROCESSED_SHORTS_DIR=data/processed_shorts
LEDGER_FILE=config/ledger.json
