{
  "system": {
    "name": "ARIS Content Automation System",
    "version": "1.1.0",
    "target_os": "Windows",
    "deployment": "local-first"
  },
  "pipeline": {
    "mode": "review",
    "review_gate_enabled": true,
    "schedule_cron": "0 14 * * *",
    "timezone": "Asia/Dhaka",
    "website_url": "https://anime.ariswork.site",
    "brand_name": "ARIS ANIME",
    "channel_name": "iταchι Live",
    "default_hashtags": [
      "#anime",
      "#animereels",
      "#animeshorts",
      "#arisanime",
      "#itachilive",
      "#otaku"
    ]
  },
  "auto_sourcing": {
    "enabled": true,
    "max_duration_seconds": 60,
    "search_queries": [
      "anime epic fight scene 4k",
      "jujutsu kaisen gojo epic moment 4k",
      "demon slayer tanjiro hinokami kagura 4k",
      "solo leveling sung jinwoo shadow monarch",
      "one piece luffy gear 5 viral edit",
      "bleach ichigo bankai 4k edit",
      "attack on titan levi vs beast titan 4k"
    ]
  },
  "video_processing": {
    "ffmpeg_path": "tools/ffmpeg.exe",
    "max_duration_seconds": 58,
    "target_width": 1080,
    "target_height": 1920,
    "video_codec": "libx264",
    "audio_codec": "aac",
    "crf": 18,
    "preset": "fast",
    "anti_copyright": {
      "enabled": true,
      "edge_crop_ratio": 0.96,
      "contrast": 1.06,
      "saturation": 1.14,
      "unsharp": true,
      "speed_multiplier": 1.04,
      "audio_tempo": 1.04,
      "gaussian_blur_background": true
    }
  },
  "gemini": {
    "model": "gemini-2.5-flash",
    "temperature": 0.7,
    "max_tokens": 1024,
    "daily_request_limit": 100,
    "track_quota": true
  },
  "publishing": {
    "youtube": {
      "enabled": true,
      "privacy_status": "public",
      "category_id": "1",
      "made_for_kids": false
    },
    "facebook": {
      "enabled": false,
      "page_post_as_reel": true
    }
  },
  "seo_tracking": {
    "enabled": true,
    "pull_interval_days": 1,
    "row_limit": 25
  }
}
